#!/bin/sh
# /init — e1LibreOS PID 1 bootstrap
# 内核把 initramfs 解压为根文件系统后，第一个执行的进程就是本脚本。
# 注意：此时 /dev 可能完全为空，任何 2>/dev/null 重定向都会导致命令被跳过！

BB=/bin/busybox

$BB mkdir -p /proc /sys /dev /tmp /run /srv
$BB mount -t proc  proc  /proc
$BB mount -t sysfs sysfs /sys

# initramfs 不会自动挂载 devtmpfs —— 手动挂载；失败则用 mdev 从 /sys 生成节点
if ! $BB grep -q ' /dev devtmpfs' /proc/mounts; then
    $BB mount -t devtmpfs devtmpfs /dev || $BB mdev -s
fi

# 关键设备节点兜底（devtmpfs 挂载成功时这些节点已存在，测试会通过）
[ -c /dev/console ] || $BB mknod -m 600 /dev/console c 5 1
[ -c /dev/null ]    || $BB mknod -m 666 /dev/null    c 1 3
[ -c /dev/tty ]     || $BB mknod -m 666 /dev/tty     c 5 0
[ -c /dev/tty1 ]    || $BB mknod -m 620 /dev/tty1    c 4 1
[ -c /dev/ttyS0 ]   || $BB mknod -m 620 /dev/ttyS0   c 4 64
$BB mdev -s

# 补齐 busybox 其余 applet 的符号链接（/bin /sbin /usr/bin /usr/sbin）
# 注意：目标目录必须先存在，且此构建没有 exec applet，需用 shell 内建 exec
$BB mkdir -p /bin /sbin /usr/bin /usr/sbin
$BB --install -s

$BB mkdir -p /dev/pts /dev/shm
$BB mount -t devpts devpts /dev/pts
$BB mount -t tmpfs tmpfs /dev/shm

# 交给 busybox init，它读取 /etc/inittab 继续引导
exec /sbin/init
