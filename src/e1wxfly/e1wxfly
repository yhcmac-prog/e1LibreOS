#!/usr/bin/env python3
# e1wxfly — e1LibreOS 应用包装工具（类似 WineBotter / Wineskin）
# 把 EXE 或第三方 X11/Wayland 应用包装为独立可分发的产物
#
# 用法:
#   e1wxfly elf  <input.exe>  [-n name] [-o output]
#       生成 Linux 自解压 ELF（内嵌 EXE + e1wine，自动 chmod +x）
#   e1wxfly app  <input.exe>  [-n name] [-i icon.icns] [-o Name.app]
#       生成 macOS .app 应用包（universal 启动器 + EXE）
#   e1wxfly wrap-x11 <binary-or-script> [-n name] [-o output]
#       包装 X11/Wayland 应用为单文件 ELF（内嵌启动脚本，自动加权）
#
# 与 e1wine 的关系：
#   e1wine 是运行时兼容层（直接运行 EXE）
#   e1wxfly 是打包工具（把应用+启动器合成可分发的产物）

import os, sys, struct, subprocess, shutil, argparse, stat, zlib

E1_TRL_MAGIC = b"E1WXFLY1"
E1_TRL_FIXED = 24

def crc32(data: bytes) -> int:
    return zlib.crc32(data) & 0xffffffff

def put_le64(v): return struct.pack("<Q", v)
def put_le32(v): return struct.pack("<I", v)

# ---------------------------------------------------------------------------
# elf — 自包含 Linux 包装器
#
# 产物布局（单个可执行 shell 脚本，自动 chmod 0755）：
#   [shell 头 + heredoc Python，Python 中内嵌 base64(e1wine ELF)]
#   [原始 EXE 字节]
#   [E1WXFLY1 trailer: u64 size | u32 crc | u32 namelen | name]
# 运行时 Python 从自身尾部读出 EXE、从内嵌 b64 还原 e1wine，
# 解到 ~/.cache/e1wxfly/ 后 execv —— 不依赖目标机预装任何东西（除 python3）。
# ---------------------------------------------------------------------------

ELF_WRAPPER_HEAD = '''#!/bin/sh
# e1wxfly self-extracting Linux wrapper (generated, do not edit)
SELF="$0"
CACHEDIR="${XDG_CACHE_HOME:-$HOME/.cache}/e1wxfly"
mkdir -p "$CACHEDIR" 2>/dev/null || CACHEDIR="/tmp/e1wxfly-$$"
mkdir -p "$CACHEDIR"
exec python3 - "$SELF" "$CACHEDIR" "$@" <<'PYEOF'
import os, sys, struct, zlib, base64

E1WINE_B64 = b"@@EWINE_B64@@"
E1WINE_CRC = @@EWINE_CRC@@
MAGIC = b"E1WXFLY1"; FIXED = 24

self_path, cache = sys.argv[1], sys.argv[2]
fwd = sys.argv[3:]

def unpack(path, data, crc_expected):
    if not (os.path.exists(path) and os.path.getsize(path) == len(data)
            and (zlib.crc32(open(path, "rb").read()) & 0xffffffff) == crc_expected):
        tmp = path + ".tmp"
        with open(tmp, "wb") as f:
            f.write(data)
        os.chmod(tmp, 0o755)
        os.rename(tmp, path)
    os.chmod(path, 0o755)

# 1) e1wine 运行时（base64 内嵌）
ew = base64.b64decode(E1WINE_B64)
ew_path = os.path.join(cache, "e1wine-%08x" % E1WINE_CRC)
if (zlib.crc32(ew) & 0xffffffff) != E1WINE_CRC:
    sys.exit("e1wxfly: embedded e1wine corrupted")
unpack(ew_path, ew, E1WINE_CRC)

# 2) 自身尾部的 EXE
blob = open(self_path, "rb").read()
i = blob.rfind(MAGIC)
if i < 0 or i + FIXED > len(blob):
    sys.exit("e1wxfly: payload trailer missing")
size, crc, nl = struct.unpack("<QII", blob[i+8:i+FIXED])
name = blob[i+FIXED:i+FIXED+nl].decode("utf-8", "replace")
if i + FIXED + nl != len(blob) or size + FIXED + nl > len(blob):
    sys.exit("e1wxfly: bad payload layout")
off = len(blob) - (FIXED + nl) - size
exe = blob[off:off+size]
if (zlib.crc32(exe) & 0xffffffff) != crc:
    sys.exit("e1wxfly: payload CRC mismatch")
exe_path = os.path.join(cache, "%08x-%s" % (crc, name))
unpack(exe_path, exe, crc)

os.execv(ew_path, [ew_path, exe_path] + fwd)
PYEOF
'''

def cmd_elf(args):
    launcher = os.environ.get("E1WINE_ELF_LAUNCHER", "")
    if not launcher:
        for cand in ("e1wine-linux-x86_64", "./e1wine-linux-x86_64",
                     "dist/e1wine-linux-x86_64"):
            if os.path.isfile(cand) and os.access(cand, os.X_OK):
                launcher = cand
                break
    if not launcher:
        print("e1wxfly: 找不到 Linux ELF 版 e1wine 作为包装器。", file=sys.stderr)
        print("  请设置 E1WINE_ELF_LAUNCHER，或把 e1wine-linux-x86_64 放到当前目录 / dist/。",
              file=sys.stderr)
        return 1

    name = args.name or os.path.splitext(os.path.basename(args.exe))[0] or "program"
    out = args.output or f"./{name}-linux"

    with open(launcher, "rb") as f:
        ewine = f.read()
    with open(args.exe, "rb") as f:
        exe_data = f.read()

    import base64
    head = (ELF_WRAPPER_HEAD
            .replace("@@EWINE_B64@@", base64.b64encode(ewine).decode("ascii"))
            .replace("@@EWINE_CRC@@", str(crc32(ewine)))
            ).encode()

    exe_crc = crc32(exe_data)
    name_b = name.encode()
    with open(out, "wb") as f:
        f.write(head)
        f.write(exe_data)
        f.write(E1_TRL_MAGIC)
        f.write(put_le64(len(exe_data)))
        f.write(put_le32(exe_crc))
        f.write(put_le32(len(name_b)))
        f.write(name_b)
    os.chmod(out, 0o755)
    print(f"已生成自包含 Linux 程序（自动 chmod +x）：{out}")
    print(f"  内含 e1wine({len(ewine)}B) + {args.exe}({len(exe_data)}B)")
    print(f"  运行：{out}   # 解包到 ~/.cache/e1wxfly/ 后由 e1wine 加载")
    return 0

# ---------------------------------------------------------------------------
# convert --app
# ---------------------------------------------------------------------------

def cmd_app(args):
    name = args.name or os.path.splitext(os.path.basename(args.exe))[0] or "program"
    bundle = args.output or f"./{name}.app"

    macos_dir = os.path.join(bundle, "Contents/MacOS")
    resources_dir = os.path.join(bundle, "Contents/Resources")
    os.makedirs(macos_dir, exist_ok=True)
    os.makedirs(resources_dir, exist_ok=True)

    # 启动器
    launcher_src = os.environ.get("E1WINE_MAC_LAUNCHER", "")
    if not launcher_src:
        for cand in ("e1wine-mac-launcher-universal", "./e1wine-mac-launcher-universal"):
            if os.path.isfile(cand) and os.access(cand, os.X_OK):
                launcher_src = cand
                break
    if not launcher_src:
        print("e1wxfly: 缺少 macOS universal 启动器。", file=sys.stderr)
        print("  请设置 E1WINE_MAC_LAUNCHER 或把 e1wine-mac-launcher-universal 放到当前目录。", file=sys.stderr)
        return 1

    shutil.copy2(launcher_src, os.path.join(macos_dir, "e1wine-launcher"))
    os.chmod(os.path.join(macos_dir, "e1wine-launcher"), 0o755)

    # EXE 载荷
    base = os.path.basename(args.exe)
    shutil.copy2(args.exe, os.path.join(resources_dir, base))
    with open(os.path.join(resources_dir, "payload-name"), "w") as f:
        f.write(base)

    # 图标
    if args.icon:
        shutil.copy2(args.icon, os.path.join(resources_dir, "AppIcon.icns"))

    # Info.plist
    plist = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>{name}</string>
  <key>CFBundleDisplayName</key><string>{name}</string>
  <key>CFBundleIdentifier</key><string>org.e1libreos.{name}</string>
  <key>CFBundleVersion</key><string>1.0</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleExecutable</key><string>e1wine-launcher</string>
"""
    if args.icon:
        plist += "  <key>CFBundleIconFile</key><string>AppIcon</string>\n"
    plist += """  <key>LSMinimumSystemVersion</key><string>10.13</string>
  <key>NSHighResolutionCapable</key><true/>
</dict></plist>
"""
    with open(os.path.join(bundle, "Contents/Info.plist"), "w") as f:
        f.write(plist)

    print(f"已生成 macOS 应用包：{bundle}")
    print(f"  启动器：Contents/MacOS/e1wine-launcher（x86_64+arm64 universal）")
    print(f"  载荷：  Contents/Resources/{base}（运行时委托系统 Wine 执行）")
    return 0

# ---------------------------------------------------------------------------
# wrap-x11 — 包装第三方 X11/Wayland 应用
# ---------------------------------------------------------------------------

X11_WRAPPER_TEMPLATE = '''#!/bin/sh
# e1wxfly X11/Wayland 自解压包装器 — 由 e1wxfly wrap-x11 生成
# 尾部内嵌应用二进制 + E1WXFLY1 trailer；首次运行解包后 exec。
SELF="$0"
CACHEDIR="${XDG_CACHE_HOME:-$HOME/.cache}/e1wxfly"
mkdir -p "$CACHEDIR" 2>/dev/null || CACHEDIR=/tmp/e1wxfly-$$
mkdir -p "$CACHEDIR"

EXTRACTED=$(SELF="$SELF" CACHEDIR="$CACHEDIR" python3 - <<'PYEOF'
import os, struct, zlib, sys
self_path = os.environ["SELF"]; cache = os.environ["CACHEDIR"]
MAGIC = b"E1WXFLY1"; FIXED = 24
data = open(self_path, "rb").read()
i = data.rfind(MAGIC)
if i < 0 or i + FIXED > len(data):
    sys.exit(1)
size, crc, nl = struct.unpack("<QII", data[i+8:i+FIXED])
name = data[i+FIXED:i+FIXED+nl].decode("utf-8", "replace")
if i + FIXED + nl != len(data) or size + FIXED + nl > len(data):
    sys.exit(1)
off = len(data) - (FIXED + nl) - size
blob = data[off:off+size]
if (zlib.crc32(blob) & 0xffffffff) != crc:
    sys.exit(1)
out = os.path.join(cache, "%08x-%s" % (crc, name))
if not (os.path.exists(out) and os.path.getsize(out) == size):
    tmp = out + ".tmp"
    open(tmp, "wb").write(blob)
    os.chmod(tmp, 0o755)
    os.rename(tmp, out)
os.chmod(out, 0o755)
print(out)
PYEOF
)

if [ -z "$EXTRACTED" ] || [ ! -x "$EXTRACTED" ]; then
    echo "e1wxfly: failed to unpack embedded application" >&2
    exit 1
fi

# 若需要 X 显示而 DISPLAY/WAYLAND_DISPLAY 均未设置，给出明确提示
if [ -z "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ]; then
    echo "e1wxfly: no X11/Wayland display (DISPLAY/WAYLAND_DISPLAY unset)" >&2
fi

exec "$EXTRACTED" "$@"
'''

def cmd_wrap_x11(args):
    name = args.name or os.path.splitext(os.path.basename(args.binary))[0] or "app"
    out = args.output or f"./{name}-x11"

    # 生成包装器脚本
    with open(out, "w") as f:
        f.write(X11_WRAPPER_TEMPLATE)
    os.chmod(out, 0o755)

    # 追加二进制载荷
    with open(args.binary, "rb") as fin:
        bin_data = fin.read()
    crc = crc32(bin_data)
    namelen = len(name.encode())

    with open(out, "ab") as fout:
        fout.write(bin_data)
        fout.write(E1_TRL_MAGIC)
        fout.write(put_le64(len(bin_data)))
        fout.write(put_le32(crc))
        fout.write(put_le32(namelen))
        fout.write(name.encode())

    os.chmod(out, 0o755)
    print(f"已生成 X11/Wayland 包装器（自动 chmod +x）：{out}")
    print(f"  运行：{out}   # 自动解包内嵌的 {args.binary} 后启动")
    return 0

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        prog="e1wxfly",
        description="e1LibreOS 应用包装工具（类似 WineBotter / Wineskin）",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__
    )
    sub = parser.add_subparsers(dest="cmd")

    p_elf = sub.add_parser("elf", help="EXE → Linux 自解压 ELF")
    p_elf.add_argument("exe", help="输入 EXE 文件")
    p_elf.add_argument("-n", "--name", help="应用名")
    p_elf.add_argument("-o", "--output", help="输出路径")

    p_app = sub.add_parser("app", help="EXE → macOS .app 应用包")
    p_app.add_argument("exe", help="输入 EXE 文件")
    p_app.add_argument("-n", "--name", help="应用名")
    p_app.add_argument("-i", "--icon", help=".icns 图标")
    p_app.add_argument("-o", "--output", help="输出路径")

    p_x11 = sub.add_parser("wrap-x11", help="包装 X11/Wayland 应用")
    p_x11.add_argument("binary", help="应用二进制或脚本")
    p_x11.add_argument("-n", "--name", help="应用名")
    p_x11.add_argument("-o", "--output", help="输出路径")

    args = parser.parse_args()
    if not args.cmd:
        parser.print_help()
        return 1

    if args.cmd == "elf":
        return cmd_elf(args)
    elif args.cmd == "app":
        return cmd_app(args)
    elif args.cmd == "wrap-x11":
        return cmd_wrap_x11(args)
    return 1

if __name__ == "__main__":
    sys.exit(main())
