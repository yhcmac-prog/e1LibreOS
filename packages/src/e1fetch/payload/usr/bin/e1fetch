#!/bin/sh
# e1fetch — e1LibreOS 系统信息展示
os=$(grep PRETTY_NAME /etc/os-release | cut -d'"' -f2)
krn=$(uname -r)
host=$(hostname)
up=$(cut -d' ' -f1 /proc/uptime | awk '{printf "%d min", $1/60}')
mem=$(awk '/MemTotal/{printf "%d MB", $2/1024}' /proc/meminfo)
pkgs=$(ls /var/lib/e1pkg/installed 2>/dev/null | grep -v '\.files$' | wc -l)

cat <<'LOGO'
    ___    ____  _____ _    __  __ ___    ____
   |__ \  |  _ \| ____| |   \ \/ /|__ \  |  _ \
    __) | | |_) |  _| | |    \  /   / /  | |_) |
   |__ <  |  _ <| |___| |___ /  \  / /_  |  _ <
   |___/  |_| \_\_____|_____/_/\_\/____| |_| \_\
LOGO
echo ""
printf "  OS      : %s\n" "$os"
printf "  Kernel  : %s\n" "$krn"
printf "  Hostname: %s\n" "$host"
printf "  Uptime  : %s\n" "$up"
printf "  Memory  : %s\n" "$mem"
printf "  Packages: %d (via e1pkg)\n" "$pkgs"
echo ""
cowsay "Powered by e1pkg — dnf-style package manager"
